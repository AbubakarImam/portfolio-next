# Copy to .env.local and fill in.

# MongoDB connection string. Locally: mongodb://127.0.0.1:27017/portfolio
# Production: your MongoDB Atlas string, e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
DATABASE_URL=mongodb://127.0.0.1:27017/portfolio

# Long random string used to sign admin logins. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=

# Set to true only while creating the first admin account at /admin, then remove it.
# While unset, nobody can create an account without already being signed in.
ALLOW_FIRST_ADMIN=true

# Production only: Vercel Blob token for image uploads (Vercel > Storage > Blob).
# Leave unset locally; images are then saved to ./media.
BLOB_READ_WRITE_TOKEN=
